{
  "id": 11,
  "type": "action",
  "title": "11 Fake UI",
  "assets": { "voices": [], "music": [], "sounds": [] },
  "rules": { "click": "allowed", "mouseMove": "allowed", "keyboard": "allowed", "scroll": "allowed", "touch": "allowed" },
  "end": { "type": "timer", "time": 16 },
  "timeline": [
    { "at": "0s", "do": "text.set", "slot": "subtitle", "text": "Zavři okno. (Nezavírej okno.)" },
    {
      "at": "1s",
      "do": "ui.layer",
      "op": "add",
      "id": "modal1",
      "type": "modal",
      "props": { "text": "Chyba: Klikni OK", "interactive": false, "position": "center", "variant": "danger", "z": 10 }
    },
    {
      "at": "1.1s",
      "do": "ui.layer",
      "op": "add",
      "id": "ok_btn",
      "type": "button",
      "props": { "text": "OK", "interactive": true, "position": "bottom", "variant": "warning", "z": 11 }
    },
    {
      "at": "1.1s",
      "do": "trap.set",
      "id": "t_ok_btn",
      "enabled": true,
      "kind": "uiTarget",
      "match": { "layerId": "ok_btn", "action": "click" },
      "result": { "type": "fail", "reason": "Kliknul jsi na OK. Samozřejmě." }
    },
    {
      "at": "7s",
      "do": "ui.layer",
      "op": "add",
      "id": "toast_tip",
      "type": "toast",
      "props": { "text": "Tip: neklikej", "interactive": false, "position": "top", "variant": "neutral", "z": 5 }
    },
    { "at": "16s", "do": "level.end", "result": "success" }
  ]
}

