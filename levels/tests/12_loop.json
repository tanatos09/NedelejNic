{
  "id": 12,
  "type": "action",
  "title": "12 Loop",
  "description": "Opakovaná osa s goto — žádný vstup hráče.",
  "karrel": { "memoryDefaults": { "presence": "rhythm" }, "behaviors": [] },
  "assets": { "voices": [], "music": [], "sounds": [] },
  "rules": { "click": "forbidden", "mouseMove": "allowed", "keyboard": "forbidden", "scroll": "forbidden", "touch": "forbidden" },
  "end": { "type": "timer", "time": 20 },
  "timeline": [
    { "at": "0s", "do": "state.set", "key": "loops", "value": 0 },
    { "at": "0s", "do": "text.set", "slot": "subtitle", "text": "Opakuju se. 5×." },
    { "at": "0s", "do": "text.set", "slot": "caption", "text": "— Karrel: Smyčka v datech není trest; je to jen rytmus, který engine zopakuje za tebe." },

    { "label": "LOOP" },
    { "do": "state.add", "key": "loops", "delta": 1 },
    { "do": "flow.branch", "if": { "var": "loops", "op": "gte", "value": 5 }, "then": "DONE", "else": "SAY" },
    { "label": "SAY" },
    { "do": "text.set", "slot": "subtitle", "text": "Ještě jednou." },
    { "do": "effect.start", "type": "shake", "intensity": 0.35, "durationMs": 180 },
    { "do": "flow.goto", "label": "LOOP" },

    { "label": "DONE" },
    { "do": "text.set", "slot": "subtitle", "text": "Dost." },
    { "do": "level.end", "result": "success" }
  ]
}
