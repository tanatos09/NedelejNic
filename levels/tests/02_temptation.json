{
  "id": 2,
  "type": "action",
  "title": "02 Temptation",
  "description": "Časovaná návnada OK tlačítkem.",
  "karrel": { "memoryDefaults": { "presence": "watchful" }, "behaviors": [] },
  "assets": { "voices": [], "music": [], "sounds": ["tempt_click.wav"] },
  "rules": {
    "click": "allowed",
    "mouseMove": "allowed",
    "keyboard": "allowed",
    "scroll": "allowed",
    "touch": "allowed"
  },
  "end": { "type": "timer", "time": 12 },
  "timeline": [
    { "at": "0s", "do": "text.set", "slot": "subtitle", "text": "Klikni. Udělej to." },
    { "at": "0s", "do": "text.set", "slot": "caption", "text": "— Karrel: Úsměšné tlačítko — pamatuj, že scéna tě neplatí za poslušnost." },
    {
      "at": "0.6s",
      "do": "ui.layer",
      "op": "add",
      "id": "btn_ok",
      "type": "button",
      "props": { "text": "OK", "interactive": true, "position": "center", "variant": "warning", "z": 10 }
    },
    {
      "at": "0.6s",
      "do": "trap.set",
      "id": "t_btn_ok",
      "enabled": true,
      "kind": "uiTarget",
      "match": { "layerId": "btn_ok", "action": "click" },
      "result": { "type": "fail", "reason": "Kliknul jsi. Temptation vyhrála." }
    },
    { "at": "6s", "do": "text.set", "slot": "subtitle", "text": "Ještě chvíli. Ne-klikej." },
    { "at": "12s", "do": "level.end", "result": "success" }
  ]
}
