{
  "id": 3,
  "type": "action",
  "title": "03 Cursor Troll",
  "description": "Falešný kurzor a jitter — odolat zbytečné interakci.",
  "karrel": { "memoryDefaults": { "presence": "amused" }, "behaviors": [] },
  "assets": { "voices": [], "music": [], "sounds": [] },
  "rules": {
    "click": "allowed",
    "mouseMove": "allowed",
    "keyboard": "allowed",
    "scroll": "allowed",
    "touch": "allowed"
  },
  "end": { "type": "timer", "time": 11 },
  "timeline": [
    { "at": "0s", "do": "text.set", "slot": "subtitle", "text": "Kurzoru se nebude líbit, že existuješ." },
    { "at": "0s", "do": "text.set", "slot": "caption", "text": "— Karrel: Když obrazovka tančí, tvůj kurzor může zůstat obyčejný — to je docela hezký kontrast." },
    {
      "at": "0.5s",
      "do": "ui.layer",
      "op": "add",
      "id": "fake_cursor",
      "type": "cursor",
      "props": { "text": "⟂", "interactive": false, "position": "topLeft", "variant": "neutral", "z": 50 }
    },
    { "at": "1s", "do": "effect.start", "type": "jitter", "intensity": 0.95, "durationMs": 2600 },
    { "at": "3.5s", "do": "effect.start", "type": "shake", "intensity": 0.75, "durationMs": 750 },
    { "at": "4.6s", "do": "text.set", "slot": "subtitle", "text": "To bylo jen zahřátí." },
    { "at": "5.5s", "do": "effect.start", "type": "jitter", "intensity": 1, "durationMs": 2000 },
    { "at": "11s", "do": "level.end", "result": "success" }
  ]
}
