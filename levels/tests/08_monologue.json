    { "label": "obs_mid" },
    { "do": "text.set", "slot": "subtitle", "text": "Z pozorování vyplývá jednoznačný závěr." },
    { "do": "audio.play", "kind": "voice", "file": "8-2.mp3", "loop": false, "volume": 1 },
    { "do": "flow.goto", "label": "obs_done" },

    { "label": "obs_done" },

    { "at": "11s", "do": "text.set", "slot": "subtitle", "text": "Tento experiment je doslova naprostá ztráta času." },
