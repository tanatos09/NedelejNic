{
  "id": 21,
  "type": "action",
  "title": "21 Narrator Arc",
  "description": "Třífázový hlas podmíněný stavem tone.",
  "karrel": { "memoryDefaults": { "presence": "story_voice" }, "behaviors": [] },
  "assets": { "voices": ["n1.mp3", "n2.mp3", "n3.mp3"], "music": [], "sounds": [] },
  "rules": { "click": "forbidden", "mouseMove": "allowed", "keyboard": "forbidden", "scroll": "forbidden", "touch": "forbidden" },
  "end": { "type": "timer", "time": 18 },
  "timeline": [
    { "at": "0s", "do": "state.set", "key": "tone", "value": 0 },
    { "at": "0s", "do": "text.set", "slot": "subtitle", "text": "Jsem tady." },
    { "at": "0s", "do": "text.set", "slot": "caption", "text": "— Karrel: Ticho kolem hlasy nechávám záměrně — ať neslyšíš jen můj filtr slov." },
    { "at": "0.2s", "do": "audio.play", "kind": "voice", "file": "n1.mp3", "id": "v1" },

    { "at": "5.5s", "do": "state.add", "key": "tone", "delta": 1 },
    { "at": "5.5s", "do": "flow.branch", "if": { "var": "tone", "op": "gte", "value": 1 }, "then": "T1", "else": "T0" },
    { "label": "T0" },
    { "do": "flow.goto", "label": "MID" },
    { "label": "T1" },
    { "do": "text.set", "slot": "subtitle", "text": "Začínáš chápat, že nic není hra." },
    { "do": "audio.play", "kind": "voice", "file": "n2.mp3", "id": "v2" },
    { "label": "MID" },

    { "at": "11.5s", "do": "state.add", "key": "tone", "delta": 1 },
    { "at": "11.5s", "do": "flow.branch", "if": { "var": "tone", "op": "gte", "value": 2 }, "then": "T2", "else": "ENDTXT" },
    { "label": "T2" },
    { "do": "text.set", "slot": "subtitle", "text": "Dobře. Teď už jen dojeď do konce." },
    { "do": "audio.play", "kind": "voice", "file": "n3.mp3", "id": "v3" },
    { "label": "ENDTXT" },

    { "at": "18s", "do": "level.end", "result": "success" }
  ]
}
