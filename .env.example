# Databáze — PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/nedelejnic"

# Session secret — minimálně 32 náhodných znaků, NIKDY nesdílet
SESSION_SECRET="zmenit-na-nahodny-retezec-min-32-znaku-prosim"

# Port backendu
PORT=3001

# Node environment
NODE_ENV=development

# URL frontendu (pro CORS)
CLIENT_URL=http://localhost:5173
